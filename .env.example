# ========================================================
# OVERCLOCK STORE // AMBIENTE & CONFIGURAÇÕES
# ========================================================

# --------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL)
# --------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overclock_store?schema=public"

# --------------------------------------------------------
# 2. AUTENTICAÇÃO (NextAuth / Auth.js)
# --------------------------------------------------------
# URL base do site (use http://localhost:3000 em dev)
NEXTAUTH_URL="http://localhost:3000"
# Gere uma chave com: openssl rand -base64 32
NEXTAUTH_SECRET="substitua_por_uma_chave_secreta_forte_32_bytes"

# Provedor Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# --------------------------------------------------------
# 3. DISCORD OAUTH & BOT ENTERPRISE (Discord Developer Portal)
# --------------------------------------------------------
DISCORD_CLIENT_ID="seu_discord_client_id"
DISCORD_CLIENT_SECRET="seu_discord_client_secret"
DISCORD_BOT_TOKEN="seu_token_do_bot_do_discord"
DISCORD_GUILD_ID="id_do_servidor_discord"
DISCORD_VERIFIED_ROLE_ID="id_do_cargo_verificado"
DISCORD_CUSTOMER_ROLE_ID="id_do_cargo_cliente"

# --------------------------------------------------------
# 4. GATEWAYS DE PAGAMENTO (Fase 3C)
# --------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Mercado Pago (Pix & Cartão BR)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="seu_webhook_secret_mercadopago"

# Crypto Gateway (BTC / USDT / ETH)
CRYPTO_API_KEY="seu_crypto_api_key"
CRYPTO_WEBHOOK_SECRET="seu_crypto_webhook_secret"

# --------------------------------------------------------
# 5. E-MAILS TRANSACIONAIS (Resend)
# --------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Overclock Store <noreply@overclockstore.com>"

# --------------------------------------------------------
# 6. CONFIGURAÇÕES PÚBLICAS DO APP
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# 7. BOT INTERNO & TICKETS (/api/bot/*)
# --------------------------------------------------------
INTERNAL_BOT_SECRET="sua_chave_secreta_interna_para_o_bot"
